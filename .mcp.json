{
  "servers": {
    "F#": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
        "tool",
        "run",
        "fslangmcp"
      ]
    },
    "GitHub": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "Microsoft Docs": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    }
  },
  "mcpServers": {
    "F#": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
        "tool",
        "run",
        "fslangmcp"
      ]
    },
    "GitHub": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headersHelper": "pwsh -NoProfile -File .claude/scripts/github-mcp-headers.ps1"
    },
    "Microsoft Docs": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    }
  }
}
